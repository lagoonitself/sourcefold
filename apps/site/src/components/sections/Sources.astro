---
/**
 * Sources section (section id "sources").
 *
 * SectionHeader:
 * - label: "Supported sources"
 * - title: "Save from the ten places research "
 * - marked: "comes from"
 * - lede: "Every source becomes a clean Markdown file. Paste 30–40 links of any mix."
 *
 * Interactive picker:
 * - List/grid of 10 SOURCES (SourceTile + name)
 * - Selected item gets bg-accent fill and source colour's 3px left bar
 * - Beside it: .sheet file preview that cross-fades
 *   - "Save it with" (savedWith)
 *   - "What you get" (youGet)
 *   - Realistic Markdown preview in Geist Mono with syntax-tinted front matter & body
 * - Auto-cycle every ~3.5s while visible until user interacts, with thin progress line
 * - Roving tabindex + arrow key navigation (role="tablist" / "tab" + "tabpanel")
 *
 * Below:
 * - Honest note about sites that refuse pasted links (save with extension)
 * - Mention notes and images sit next to sources (EXTRA_KINDS)
 */
import SectionHeader from "../SectionHeader.astro";
import SourceTile from "../SourceTile.astro";
import { SOURCES, EXTRA_KINDS, type SourceKind } from "../../lib/sources";

interface SourceDetail {
  kind: SourceKind;
  authorLabel: "author" | "channel";
  authorValue: string;
  savedDate: string;
  bodyLines: Array<{
    type: "p" | "heading" | "quote" | "subquote" | "ref-header" | "ref-item" | "image" | "timestamp" | "comment" | "math";
    text: string;
    subtext?: string;
    url?: string;
  }>;
}

