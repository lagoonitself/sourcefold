# Supabase project URL (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google account(s) allowed to sign in, comma-separated
ALLOWED_EMAIL=
# Supabase secret key (starts with sb_secret_). Server only: extension tokens and Drive save.
SUPABASE_SECRET_KEY=
# Google OAuth web client (Google Cloud > Google Auth Platform > Clients). Used to refresh Drive access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
