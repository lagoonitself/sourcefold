---
/**
 * Files.astro (id "files") — "Your files, your Drive"
 * Interactive diagram showing how a source fans out into:
 * 1. Clean Markdown (.md) with front matter and footnotes
 * 2. Google Drive mirror with Google Docs for NotebookLM & Gemini
 * 3. Desktop local Documents/Sourcefold copy with Word (.docx) beside each file.
 * Interactive "Save to Drive" button + Ctrl/Cmd+S keyboard shortcut + Offline/Signed-in toggle.
 */
import {
  Cloud,
  CloudOff,
  Folder,
  HardDrive,
  Lock,
  RefreshCw,
  Sparkles,
} from "@lucide/astro";
import SectionHeader from "../SectionHeader.astro";
import SourceTile from "../SourceTile.astro";
---

<section id="files" class="section" data-files-section>
  <div class="container">
    <SectionHeader
      label="Your files, your Drive"
      title="Clean Markdown on disk, mirrored to "
      marked="your Google Drive"
      lede="Every source is a tidy .md file with a small header and footnotes. Save to Drive mirrors your folders with Google Doc copies ready for NotebookLM, Gemini, Obsidian or VS Code. Sourcefold can only see files it created in your Drive (drive.file); Supabase keeps only links, titles, folders and notes."
    />

    <!-- Interactive Diagram Card -->
    <div class="sheet diagram-wrapper" data-files-diagram data-reveal>
      <!-- Top Toolbar: Toggle Mode & Save Trigger -->
      <div class="diagram-toolbar">
        <div class="mode-toggle-group" role="tablist" aria-label="Drive sync mode">
          <span class="toggle-caption muted">Mode:</span>
          <button
            type="button"
            class="toggle-btn is-active"
            role="tab"
            aria-selected="true"
            data-mode="signed-in"
          >
            <Cloud size={14} />
            <span>Signed in (Drive sync)</span>
          </button>
          <button
            type="button"
            class="toggle-btn"
            role="tab"
            aria-selected="false"
            data-mode="offline"
          >
            <CloudOff size={14} />
            <span>Offline (local only)</span>
          </button>
        </div>

        <div class="save-action-group">
          <button
            type="button"
            class="btn btn-ink btn-sm save-trigger-btn"
            data-files-save-btn
            aria-label="Save to Drive (Ctrl+S or Cmd+S)"
          >
            <RefreshCw size={14} class="save-icon" />
            <span class="save-label">Save to Drive</span>
            <span class="kbd-combo" aria-hidden="true">
              <span class="kbd">Ctrl</span>
              <span class="kbd">S</span>
            </span>
          </button>
          <div class="save-status-indicator" data-save-status>
            <span class="ping-dot" aria-hidden="true"></span>
            <span class="status-msg">Ready to sync</span>
          </div>
        </div>
      </div>

      <!-- Fan-out Diagram Content -->
      <div class="diagram-grid">
        <!-- Center Origin: The Saved Source -->
        <div class="origin-column">
          <div class="origin-card card">
            <div class="origin-badge">Saved item</div>
            <div class="origin-item">
              <SourceTile kind="youtube" size={32} />
              <div class="origin-meta">
                <span class="origin-title serif">How turbo lag actually works</span>
                <span class="origin-folder muted">Cars / Engines / Lag and boost</span>
              </div>
            </div>
            <div class="fan-arrows" aria-hidden="true">
              <span class="fan-line line-1"></span>
              <span class="fan-line line-2"></span>
              <span class="fan-line line-3"></span>
            </div>
          </div>

          <div class="origin-desc">
            <span class="label">One source, three formats</span>
            <p class="muted text-sm">
              Press <kbd class="kbd">Ctrl</kbd> <kbd class="kbd">S</kbd> while here to run the sync animation.
            </p>
          </div>
        </div>

        <!-- Three Destinations Fanning Out -->
        <div class="destinations-column">
          <!-- 1. The Tidy .md File -->
          <div class="dest-card card" data-dest-card="markdown">
            <div class="dest-card-header">
              <div class="dest-title-wrap">
                <span class="dest-ext mono">.md</span>
                <h4 class="h4 dest-title">Tidy Markdown with YAML front matter</h4>
              </div>
              <span class="dest-chip chip">Geist Mono</span>
            </div>
            <div class="code-preview mono">
              <div class="code-line muted">---</div>
              <div class="code-line"><span class="k">source:</span> youtube</div>
              <div class="code-line"><span class="k">title:</span> How turbo lag actually works</div>
              <div class="code-line"><span class="k">channel:</span> Engineering Explained</div>
              <div class="code-line"><span class="k">duration:</span> 12:40</div>
              <div class="code-line"><span class="k">saved:</span> 2026-10-22</div>
              <div class="code-line"><span class="k">folder:</span> Cars/Engines/Lag and boost</div>
              <div class="code-line muted">---</div>
              <div class="code-line heading-line"># How turbo lag actually works</div>
              <div class="code-line quote-line muted">&gt; Saved from [YouTube](https://youtu.be/...) on 2026-10-22.</div>
              <div class="code-line heading-line">## Transcript</div>
              <div class="code-line">[0:47](https://youtu.be/...) Anti-lag keeps the turbine spooled...</div>
              <div class="code-line heading-line">## References</div>
              <div class="code-line footnote-line">[^1]: [sae.org](https://sae.org) - SAE Technical Paper 2308</div>
            </div>
            <div class="dest-footer muted text-xs">
              Human-readable CommonMark with footnotes. Compatible with Obsidian and VS Code.
            </div>
          </div>

          <!-- 2. Google Drive Folder Mirror -->
          <div class="dest-card card" data-dest-card="drive">
            <div class="dest-card-header">
              <div class="dest-title-wrap">
                <Cloud size={16} class="dest-icon-cloud" />
                <h4 class="h4 dest-title">Google Drive mirror</h4>
              </div>
              <span class="dest-chip chip gdoc-chip">Google Docs copy</span>
            </div>

            <!-- Drive Tree View -->
            <div class="tree-preview" data-drive-tree>
              <div class="tree-node root-folder">
                <Folder size={14} class="folder-icon" />
                <span class="folder-name mono">Sourcefold/</span>
              </div>
              <div class="tree-children">
                <div class="tree-node">
                  <Folder size={14} class="folder-icon" />
                  <span class="folder-name mono">Cars/</span>
                </div>
                <div class="tree-children">
                  <div class="tree-node">
                    <Folder size={14} class="folder-icon" />
                    <span class="folder-name mono">Engines/</span>
                  </div>
                  <div class="tree-children">
                    <div class="tree-node">
                      <Folder size={14} class="folder-icon" />
                      <span class="folder-name mono">Lag and boost/</span>
                    </div>
                    <div class="tree-children file-children">
                      <div class="tree-file file-md">
                        <span class="file-badge mono">MD</span>
                        <span class="file-name mono">How turbo lag actually works.md</span>
                      </div>
                      <div class="tree-file file-gdoc">
                        <span class="file-badge gdoc-badge mono">DOC</span>
                        <span class="file-name mono">How turbo lag actually works</span>
                        <span class="ai-ready-badge">NotebookLM & Gemini ready</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Offline Dim Overlay -->
            <div class="offline-overlay" data-offline-overlay>
              <CloudOff size={24} />
              <p class="offline-msg">
                <strong>Offline mode</strong>
                <span>No Google account required. Local SQLite and Markdown on disk; Drive mirror is skipped.</span>
              </p>
            </div>

            <div class="dest-footer muted text-xs">
              Sourcefold can only see files it created in your Drive (<span class="mono">drive.file</span> scope).
            </div>
          </div>

          <!-- 3. Desktop Documents/Sourcefold Copy with Word .docx -->
          <div class="dest-card card" data-dest-card="local">
            <div class="dest-card-header">
              <div class="dest-title-wrap">
                <HardDrive size={16} class="dest-icon-disk" />
                <h4 class="h4 dest-title">Desktop Documents / Sourcefold</h4>
              </div>
              <span class="dest-chip chip docx-chip">Word .docx beside each file</span>
            </div>

            <div class="local-files-preview">
              <div class="local-path mono muted text-xs">
                ~/Documents/Sourcefold/Cars/Engines/Lag and boost/
              </div>
              <div class="local-file-list">
                <div class="local-file-item">
                  <span class="file-pill pill-md mono">.md</span>
                  <span class="local-fname mono">How turbo lag actually works.md</span>
                  <span class="local-fmeta muted">Clean Markdown</span>
                </div>
                <div class="local-file-item">
                  <span class="file-pill pill-docx mono">.docx</span>
                  <span class="local-fname mono">How turbo lag actually works.docx</span>
                  <span class="local-fmeta muted">Word document copy</span>
                </div>
                <div class="local-file-item">
                  <span class="file-pill pill-dir mono">_files</span>
                  <span class="local-fname mono">How turbo lag actually works_files/</span>
                  <span class="local-fmeta muted">Images saved locally</span>
                </div>
              </div>
            </div>

            <div class="dest-footer muted text-xs">
              Every text source has an exported Word .docx copy on disk, readable by any local tool.
            </div>
          </div>
        </div>
      </div>

      <!-- Privacy & Architecture Callouts -->
      <div class="privacy-strip">
        <div class="privacy-pill">
          <Lock size={15} class="privacy-icon" />
          <div class="privacy-text">
            <strong>drive.file scope only</strong>: Sourcefold can only see and touch files it created inside its own folder. It cannot see your other Drive documents.
          </div>
        </div>
        <div class="privacy-pill">
          <Sparkles size={15} class="privacy-icon" />
          <div class="privacy-text">
            <strong>Ephemeral Supabase cache</strong>: Full article text and images live in Supabase only for the few seconds until they are mirrored into your Drive.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { sleep, prefersReducedMotion } from "../../lib/reveal";

  const section = document.querySelector<HTMLElement>("[data-files-section]");
  if (section) {
    const saveBtn = section.querySelector<HTMLButtonElement>("[data-files-save-btn]")!;
    const statusMsg = section.querySelector<HTMLElement>("[data-save-status] .status-msg")!;
    const pingDot = section.querySelector<HTMLElement>("[data-save-status] .ping-dot")!;
    const modeBtns = section.querySelectorAll<HTMLButtonElement>("[data-mode]");
    const driveCard = section.querySelector<HTMLElement>('[data-dest-card="drive"]')!;
    const offlineOverlay = section.querySelector<HTMLElement>("[data-offline-overlay]")!;
    const treeFiles = section.querySelectorAll<HTMLElement>(".tree-file");

    let isSectionVisible = false;
    let isSaving = false;
    let currentMode: "signed-in" | "offline" = "signed-in";

    // Track intersection for Ctrl+S keyboard shortcut
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          isSectionVisible = e.isIntersecting;
        });
      },
      { threshold: 0.2 },
    );
    observer.observe(section);

    // Mode Toggle (Signed in vs Offline)
    modeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.dataset.mode as "signed-in" | "offline";
        if (mode === currentMode) return;

        currentMode = mode;
        modeBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle("is-active", active);
          b.setAttribute("aria-selected", active ? "true" : "false");
        });

        if (currentMode === "offline") {
          driveCard.classList.add("is-offline");
          offlineOverlay.classList.add("is-visible");
          statusMsg.textContent = "Offline (local SQLite & MD)";
          saveBtn.querySelector(".save-label")!.textContent = "Save locally";
        } else {
          driveCard.classList.remove("is-offline");
          offlineOverlay.classList.remove("is-visible");
          statusMsg.textContent = "Ready to sync";
          saveBtn.querySelector(".save-label")!.textContent = "Save to Drive";
        }
      });
    });

    async function triggerSave() {
      if (isSaving) return;
      isSaving = true;

      saveBtn.classList.add("is-spinning");
      statusMsg.textContent = currentMode === "offline" ? "Writing to disk..." : "Syncing to Drive...";
      pingDot.classList.remove("pings");

      if (prefersReducedMotion()) {
        await sleep(300);
      } else {
        // Animate pulse on cards
        treeFiles.forEach((f) => f.classList.add("is-saving-pulse"));
        await sleep(650);
        treeFiles.forEach((f) => f.classList.remove("is-saving-pulse"));
      }

      saveBtn.classList.remove("is-spinning");
      statusMsg.textContent = currentMode === "offline" ? "Saved to disk" : "Saved to Drive";

      // Trigger two pings on the dot
      pingDot.classList.add("pings");

      setTimeout(() => {
        isSaving = false;
      }, 1200);
    }

    saveBtn.addEventListener("click", triggerSave);

    // Ctrl+S / Cmd+S handler only when this section is visible
    window.addEventListener("keydown", (e: KeyboardEvent) => {
      if (!isSectionVisible) return;
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "s") {
        e.preventDefault();
        triggerSave();
      }
    });
  }
</script>

<style>
  .diagram-wrapper {
    margin-top: 12px;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  /* Toolbar */
  .diagram-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 20px;
    background: var(--muted);
    border-bottom: 1px solid var(--border);
  }

  .mode-toggle-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .toggle-caption {
    font-size: 12px;
    margin-right: 4px;
  }

  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 500;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted-foreground);
    cursor: pointer;
    transition: all 140ms var(--ease-out);
  }

  .toggle-btn:hover {
    color: var(--foreground);
    border-color: var(--border-strong);
  }

  .toggle-btn.is-active {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }

  .save-action-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .save-trigger-btn {
    gap: 8px;
    font-size: 13px;
  }

  .save-trigger-btn.is-spinning :global(.save-icon) {
    animation: spin 700ms linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .kbd-combo {
    display: inline-flex;
    gap: 3px;
    margin-left: 2px;
  }

  .save-status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--muted-foreground);
  }

  .ping-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }

  .ping-dot.pings::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--success);
    animation: pingTwo 900ms ease-out 2;
  }

  @keyframes pingTwo {
    0% {
      transform: scale(0.8);
      opacity: 1;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* Grid layout */
  .diagram-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    padding: 24px;
    background: color-mix(in oklab, var(--desk) 20%, var(--background));
  }

  @media (max-width: 900px) {
    .diagram-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Origin card */
  .origin-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .origin-card {
    padding: 18px;
    border: 1px solid var(--border);
    position: relative;
  }

  .origin-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 12px;
  }

  .origin-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .origin-meta {
    display: flex;
    flex-direction: column;
  }

  .origin-title {
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--foreground);
  }

  .origin-folder {
    font-size: 11.5px;
    margin-top: 3px;
  }

  .fan-arrows {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px dashed var(--border);
  }

  .fan-line {
    height: 2px;
    background: color-mix(in oklab, var(--primary) 20%, var(--border));
    border-radius: 1px;
    position: relative;
  }

  .fan-line::after {
    content: "▶";
    position: absolute;
    right: -4px;
    top: -5px;
    font-size: 8px;
    color: var(--muted-foreground);
  }

  .origin-desc {
    padding: 14px;
    border-radius: 10px;
    background: var(--card);
    border: 1px solid var(--border);
  }

  /* Destinations */
  .destinations-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .dest-card {
    padding: 18px 20px;
    border: 1px solid var(--border);
    position: relative;
    transition: opacity 240ms var(--ease-out);
  }

  .dest-card.is-offline {
    opacity: 0.45;
  }

  .dest-card-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }

  .dest-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dest-title {
    font-size: 15px;
    font-weight: 600;
  }

  .dest-ext {
    font-size: 12px;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--muted);
    color: var(--foreground);
  }

  .dest-icon-cloud {
    color: var(--source-bluesky);
  }

  .dest-icon-disk {
    color: var(--source-web);
  }

  .gdoc-chip {
    background: color-mix(in oklab, var(--source-bluesky) 14%, transparent);
    color: var(--source-bluesky);
  }

  .docx-chip {
    background: color-mix(in oklab, var(--source-web) 14%, transparent);
    color: var(--foreground);
  }

  /* Code preview */
  .code-preview {
    font-size: 11.5px;
    line-height: 1.6;
    padding: 12px 14px;
    border-radius: 8px;
    background: var(--background);
    border: 1px solid var(--border);
    color: var(--foreground);
  }

  .code-line .k {
    color: var(--source-substack);
    font-weight: 500;
  }

  .code-line.heading-line {
    font-weight: 600;
    color: var(--foreground);
    margin-top: 4px;
  }

  .code-line.quote-line {
    font-style: italic;
  }

  .code-line.footnote-line {
    color: var(--muted-foreground);
  }

  /* Tree preview */
  .tree-preview {
    padding: 12px 14px;
    border-radius: 8px;
    background: var(--background);
    border: 1px solid var(--border);
    font-size: 12px;
    line-height: 1.5;
  }

  .tree-node {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-block: 2px;
  }

  .tree-children {
    padding-left: 16px;
    border-left: 1px solid var(--border);
    margin-left: 6px;
  }

  .file-children {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 2px;
  }

  .tree-file {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 3px 6px;
    border-radius: 5px;
    transition: background-color 200ms var(--ease-out);
  }

  .tree-file.is-saving-pulse {
    background: var(--marker-soft);
  }

  .file-badge {
    font-size: 10px;
    padding: 1px 4px;
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
  }

  .gdoc-badge {
    background: var(--source-bluesky);
    color: white;
  }

  .ai-ready-badge {
    font-size: 10.5px;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--marker-soft);
    color: var(--foreground);
    margin-left: auto;
  }

  /* Offline overlay */
  .offline-overlay {
    display: none;
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: color-mix(in oklab, var(--background) 86%, transparent);
    backdrop-filter: blur(2px);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 24px;
    text-align: center;
  }

  .offline-overlay.is-visible {
    display: flex;
  }

  .offline-msg {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 440px;
    font-size: 13px;
  }

  /* Local files preview */
  .local-files-preview {
    padding: 12px 14px;
    border-radius: 8px;
    background: var(--background);
    border: 1px solid var(--border);
  }

  .local-file-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 8px;
  }

  .local-file-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }

  .file-pill {
    font-size: 10px;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--muted);
    font-weight: 600;
  }

  .pill-md {
    color: var(--source-grokipedia);
  }
  .pill-docx {
    color: var(--source-bluesky);
  }
  .pill-dir {
    color: var(--source-web);
  }

  .local-fmeta {
    margin-left: auto;
    font-size: 11px;
  }

  .dest-footer {
    margin-top: 10px;
    line-height: 1.4;
  }

  /* Privacy callouts */
  .privacy-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 16px 20px;
    background: var(--card);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 760px) {
    .privacy-strip {
      grid-template-columns: 1fr;
    }
  }

  .privacy-pill {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 12.5px;
    line-height: 1.45;
  }

  .privacy-icon {
    flex-shrink: 0;
    color: var(--success);
    margin-top: 2px;
  }
</style>
