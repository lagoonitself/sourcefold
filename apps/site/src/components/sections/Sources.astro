---

<section id="sources" class="section sources-section">
  <div class="container">
    <SectionHeader
      label="Supported sources"
      title="Save from the ten places research "
      marked="comes from"
      lede="Every source becomes a clean Markdown file. Paste 30–40 links of any mix, or save the page you're on."
    />

    <!-- Interactive source picker and preview container -->
    <div class="sources-interactive" data-sources-picker>
      <!-- Left side: Source tablist -->
      <div
        class="sources-list"
        role="tablist"
        aria-label="Supported source types"
        data-reveal="stagger"
      >
        {
          SOURCES.map((source, index) => {
            const isSelected = index === 0;
            return (
              <button
                type="button"
                role="tab"
                id={`source-tab-${source.kind}`}
                class:list={["source-tab", { "is-selected": isSelected }]}
                aria-selected={isSelected ? "true" : "false"}
                aria-controls={`source-panel-${source.kind}`}
                tabindex={isSelected ? 0 : -1}
                data-source-kind={source.kind}
                style={`--source-brand:${source.color}`}
              >
                <div class="tab-accent-bar" aria-hidden="true" />
                <SourceTile kind={source.kind} size={28} />
                <span class="source-tab-name">{source.name}</span>
                <div class="tab-progress-line" aria-hidden="true" />
              </button>
            );
          })
        }
      </div>

      <!-- Right side: File preview sheet -->
      <div class="preview-column">
        <div class="sheet preview-sheet" aria-live="polite">
          {
            SOURCES.map((source, index) => {
              const detail = SOURCE_DETAILS[source.kind];
              const isSelected = index === 0;
              return (
                <div
                  id={`source-panel-${source.kind}`}
                  role="tabpanel"
                  aria-labelledby={`source-tab-${source.kind}`}
                  class:list={["preview-panel", { "is-active": isSelected }]}
                  data-panel-kind={source.kind}
                  hidden={!isSelected}
                >
                  <!-- Preview header metadata -->
                  <div class="preview-meta-header">
                    <div class="meta-row">
                      <span class="meta-label">Save it with:</span>
                      <span class="meta-value">{source.savedWith}</span>
                    </div>
                    <div class="meta-row">
                      <span class="meta-label">What you get:</span>
                      <span class="meta-value">{source.youGet}</span>
                    </div>
                  </div>

                  <!-- Markdown file surface -->
                  <div class="markdown-preview mono">
                    <div class="markdown-file-tab">
                      <span class="file-name">{source.exampleTitle.toLowerCase().replace(/[^a-z0-9]+/g, "-")}.md</span>
                      <span class="file-kind-badge" style={`color:${source.color}`}>
                        {source.kind}
                      </span>
                    </div>

                    <div class="markdown-content">
                      <!-- Front matter -->
                      <div class="md-frontmatter">
                        <span class="md-fence">---</span>
                        <div class="md-line">
                          <span class="md-key">title:</span>
                          <span class="md-val">"{source.exampleTitle}"</span>
                        </div>
                        <div class="md-line">
                          <span class="md-key">url:</span>
                          <span class="md-val">"https://{source.exampleUrl}"</span>
                        </div>
                        <div class="md-line">
                          <span class="md-key">{detail.authorLabel}:</span>
                          <span class="md-val">"{detail.authorValue}"</span>
                        </div>
                        <div class="md-line">
                          <span class="md-key">saved:</span>
                          <span class="md-val">"{detail.savedDate}"</span>
                        </div>
                        <div class="md-line">
                          <span class="md-key">kind:</span>
                          <span class="md-kind" style={`color:${source.color}`}>
                            {source.kind}
                          </span>
                        </div>
                        <span class="md-fence">---</span>
                      </div>

                      <!-- Realistic body lines -->
                      <div class="md-body">
                        {detail.bodyLines.map((line) => {
                          if (line.type === "heading" || line.type === "ref-header") {
                            return <div class="md-heading serif">{line.text}</div>;
                          }
                          if (line.type === "timestamp") {
                            return (
                              <div class="md-timestamp-line">
                                <span class="md-time-link">{line.text}</span>
                                <span class="md-time-text">{line.subtext}</span>
                              </div>
                            );
                          }
                          if (line.type === "quote") {
                            return <div class="md-quote">{line.text}</div>;
                          }
                          if (line.type === "subquote") {
                            return <div class="md-subquote">{line.text}</div>;
                          }
                          if (line.type === "image") {
                            return <div class="md-image-line">{line.text}</div>;
                          }
                          if (line.type === "math") {
                            return <div class="md-math-block">{line.text}</div>;
                          }
                          if (line.type === "ref-item") {
                            return <div class="md-ref-item">{line.text}</div>;
                          }
                          return <div class="md-p">{line.text}</div>;
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>

    <!-- Below: Honest note + mention of notes and images -->
    <div class="sources-footer" data-reveal>
      <div class="honest-note">
        <p class="muted">
          Some sites (Reddit, paywalled news) refuse pasted links. Save those with the extension
          while the page is open; it saves the page as you see it.
        </p>
      </div>

      <div class="extra-kinds-bar">
        <span class="extra-label muted">Also lives next to your sources:</span>
        <div class="extra-chips">
          {
            EXTRA_KINDS.map((extra) => (
              <span class="extra-chip" title={extra.youGet}>
                <SourceTile kind={extra.kind} size={22} />
                <span class="extra-name">{extra.name}</span>
                <span class="extra-desc muted">({extra.savedWith})</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { whileVisible } from "../../lib/reveal";

  const root = document.querySelector<HTMLElement>("[data-sources-picker]");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    let currentIndex = 0;
    let userInteracted = false;
    let autoCycleTimer: ReturnType<typeof setTimeout> | null = null;
    let isVisible = false;

    function selectTab(index: number, options: { focus?: boolean; programmatic?: boolean } = {}) {
      if (index < 0 || index >= tabs.length) return;
      currentIndex = index;

      tabs.forEach((tab, i) => {
        const isMatch = i === index;
        tab.classList.toggle("is-selected", isMatch);
        tab.setAttribute("aria-selected", isMatch ? "true" : "false");
        tab.tabIndex = isMatch ? 0 : -1;
        if (isMatch && options.focus) {
          tab.focus();
        }
      });

      panels.forEach((panel, i) => {
        const isMatch = i === index;
        panel.classList.toggle("is-active", isMatch);
        panel.hidden = !isMatch;
      });

      // Manage auto-cycle progress bar
      if (!userInteracted && isVisible) {
        restartCycleTimer();
      } else {
        clearCycleTimer();
      }
    }

    function clearCycleTimer() {
      if (autoCycleTimer) {
        clearTimeout(autoCycleTimer);
        autoCycleTimer = null;
      }
      tabs.forEach((t) => t.classList.remove("is-cycling"));
    }

    function restartCycleTimer() {
      clearCycleTimer();
      if (userInteracted || !isVisible) return;

      const activeTab = tabs[currentIndex];
      if (activeTab) {
        activeTab.classList.remove("is-cycling");
        void activeTab.offsetWidth; // Trigger reflow for animation restart
        activeTab.classList.add("is-cycling");
      }

      autoCycleTimer = setTimeout(() => {
        if (!userInteracted && isVisible) {
          const nextIndex = (currentIndex + 1) % tabs.length;
          selectTab(nextIndex);
        }
      }, 3500);
    }

    // Keyboard navigation (roving tabindex)
    root.addEventListener("keydown", (e) => {
      const activeEl = document.activeElement as HTMLElement | null;
      if (!activeEl || activeEl.getAttribute("role") !== "tab") return;

      let targetIndex = -1;
      if (e.key === "ArrowDown" || e.key === "ArrowRight") {
        e.preventDefault();
        userInteracted = true;
        clearCycleTimer();
        targetIndex = (currentIndex + 1) % tabs.length;
      } else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
        e.preventDefault();
        userInteracted = true;
        clearCycleTimer();
        targetIndex = (currentIndex - 1 + tabs.length) % tabs.length;
      } else if (e.key === "Home") {
        e.preventDefault();
        userInteracted = true;
        clearCycleTimer();
        targetIndex = 0;
      } else if (e.key === "End") {
        e.preventDefault();
        userInteracted = true;
        clearCycleTimer();
        targetIndex = tabs.length - 1;
      }

      if (targetIndex !== -1) {
        selectTab(targetIndex, { focus: true });
      }
    });

    // Tab click & pointer events
    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => {
        userInteracted = true;
        clearCycleTimer();
        selectTab(idx);
      });

      tab.addEventListener("mouseenter", () => {
        if (!userInteracted) {
          userInteracted = true;
          clearCycleTimer();
        }
        selectTab(idx);
      });

      tab.addEventListener("focus", () => {
        if (!userInteracted) {
          userInteracted = true;
          clearCycleTimer();
        }
        selectTab(idx);
      });
    });

    // Auto-cycle only while visible
    whileVisible(root, () => {
      isVisible = true;
      if (!userInteracted) {
        restartCycleTimer();
      }
      return () => {
        isVisible = false;
        clearCycleTimer();
      };
    });
  }
</script>

<style>
  .sources-section {
    padding-top: clamp(48px, 8vw, 96px);
  }

  .sources-interactive {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3.5vw, 44px);
    align-items: start;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  @media (min-width: 960px) {
    .sources-interactive {
      grid-template-columns: 310px 1fr;
      gap: 36px;
    }
  }

  /* Sources Tablist */
  .sources-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--card);
    padding: 8px;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-raised);
  }

  @media (max-width: 959px) {
    .sources-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 6px;
    }
  }

  .source-tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 44px;
    padding-inline: 12px 14px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
    text-align: left;
    outline: none;
    overflow: hidden;
    transition:
      background-color 140ms var(--ease-out),
      color 140ms var(--ease-out);
  }

  .source-tab:hover {
    background: var(--muted);
  }

  .source-tab:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }

  /* 3px source color bar on left when selected */
  .tab-accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3.5px;
    background: var(--source-brand);
    opacity: 0;
    transition: opacity 140ms var(--ease-out);
  }

  .source-tab.is-selected {
    background: var(--accent);
    font-weight: 500;
  }

  .source-tab.is-selected .tab-accent-bar {
    opacity: 1;
  }

  .source-tab-name {
    font-size: 14px;
    flex: 1;
  }

  /* Auto-cycle progress bar on active tab */
  .tab-progress-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--source-brand);
    opacity: 0;
    transform-origin: left;
    transform: scaleX(0);
  }

  .source-tab.is-cycling .tab-progress-line {
    opacity: 0.65;
    animation: sf-tab-progress 3.5s linear forwards;
  }

  @keyframes sf-tab-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Preview Sheet */
  .preview-column {
    min-width: 0;
  }

  .preview-sheet {
    overflow: hidden;
    border: 1px solid var(--border);
    min-height: 480px;
    display: flex;
    flex-direction: column;
  }

  .preview-panel {
    display: flex;
    flex-direction: column;
    animation: sf-panel-fade 220ms var(--ease-out);
    flex: 1;
  }

  .preview-panel[hidden] {
    display: none;
  }

  @keyframes sf-panel-fade {
    from {
      opacity: 0.4;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Metadata header */
  .preview-meta-header {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13.5px;
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    line-height: 1.45;
  }

  .meta-label {
