---
/**
 * Research section: "Research tools".
 * Covers all 7 research tools as one flowing interactive story in a single .sheet with a sliding tab bar:
 * 1. Keep / Maybe / Cut + tags
 * 2. Short summary (typed or Claude)
 * 3. Who wrote it (author + author type + guess)
 * 4. Quote cards & outline drag
 * 5. Script view + export reference list
 * 6. B-roll list (CSS thumbnails, timestamps)
 * 7. Duplicate check across groups & merge
 */
import SectionHeader from "../SectionHeader.astro";
import ResearchTriage from "../research/ResearchTriage.astro";
import ResearchSummary from "../research/ResearchSummary.astro";
import ResearchAuthor from "../research/ResearchAuthor.astro";
import ResearchOutline from "../research/ResearchOutline.astro";
import ResearchScript from "../research/ResearchScript.astro";
import ResearchBroll from "../research/ResearchBroll.astro";
import ResearchDuplicates from "../research/ResearchDuplicates.astro";

import {
  SquareCheck,
  Sparkles,
  UserCheck,
  LayoutList,
  FileText,
  Film,
  GitMerge,
  ShieldCheck,
  HardDrive,
  Cpu,
} from "@lucide/astro";

const TABS = [
  { id: "triage", label: "Triage & tags", num: "1", icon: SquareCheck },
  { id: "summary", label: "Summary", num: "2", icon: Sparkles },
  { id: "author", label: "Author & type", num: "3", icon: UserCheck },
  { id: "outline", label: "Quote cards", num: "4", icon: LayoutList },
  { id: "script", label: "Script view", num: "5", icon: FileText },
  { id: "broll", label: "B-roll list", num: "6", icon: Film },
  { id: "duplicates", label: "Duplicates", num: "7", icon: GitMerge },
];
---

<section id="research" class="section">
  <div class="container">
    <SectionHeader
      label="Research tools"
      title="From a pile of sources"
      marked="to a finished script"
      lede="Seven tools built specifically for long-form creators, journalists, and researchers. Triage in seconds, synthesize with Claude, drag cards into an outline, and export citations with zero cloud lock-in."
    />

    <!-- Main Interactive Story Sheet -->
    <div class="sheet research-sheet" data-reveal>
      <!-- Top Stepper / Tab Bar -->
      <div class="research-tabbar-wrap">
        <div class="research-tabbar" role="tablist" aria-label="Research tools stepper">
          {
            TABS.map((tab, idx) => (
              <button
                type="button"
                role="tab"
                class:list={["tab-btn", idx === 0 && "is-active"]}
                id={`tab-btn-${tab.id}`}
                data-tab-target={tab.id}
                data-tab-index={idx}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`panel-${tab.id}`}
              >
                <tab.icon size={14} stroke-width={1.75} class="tab-icon" />
                <span class="tab-num font-mono nums">{tab.num}.</span>
                <span class="tab-label">{tab.label}</span>
              </button>
            ))
          }
          <!-- Animated sliding underline indicator -->
          <div class="tab-indicator" id="tab-indicator" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Tab Content Panels -->
      <div class="research-content-area">
        <!-- Tool 1: Triage -->
        <div
          role="tabpanel"
          id="panel-triage"
          class="tool-panel is-active"
          aria-labelledby="tab-btn-triage"
        >
          <ResearchTriage />
        </div>

        <!-- Tool 2: Summary -->
        <div
          role="tabpanel"
          id="panel-summary"
          class="tool-panel"
          style="display: none;"
          aria-labelledby="tab-btn-summary"
        >
          <ResearchSummary />
        </div>

        <!-- Tool 3: Author & Type -->
        <div
          role="tabpanel"
          id="panel-author"
          class="tool-panel"
          style="display: none;"
          aria-labelledby="tab-btn-author"
        >
          <ResearchAuthor />
        </div>

        <!-- Tool 4: Quote Cards & Outline -->
        <div
          role="tabpanel"
          id="panel-outline"
          class="tool-panel"
          style="display: none;"
          aria-labelledby="tab-btn-outline"
        >
          <ResearchOutline />
        </div>

        <!-- Tool 5: Script View & Citations -->
        <div
          role="tabpanel"
          id="panel-script"
          class="tool-panel"
          style="display: none;"
          aria-labelledby="tab-btn-script"
        >
          <ResearchScript />
        </div>

        <!-- Tool 6: B-roll List -->
        <div
          role="tabpanel"
          id="panel-broll"
          class="tool-panel"
          style="display: none;"
          aria-labelledby="tab-btn-broll"
        >
          <ResearchBroll />
        </div>

        <!-- Tool 7: Duplicates Check & Merge -->
        <div
          role="tabpanel"
          id="panel-duplicates"
          class="tool-panel"
          style="display: none;"
          aria-labelledby="tab-btn-duplicates"
        >
          <ResearchDuplicates />
        </div>
      </div>

      <!-- Bottom Step Navigation Footer (No arrow icons on buttons) -->
      <div class="research-footer">
        <button type="button" class="btn btn-outline btn-sm" id="prev-tool-btn" disabled>
          <span>Previous tool</span>
        </button>

        <div class="step-progress-counter muted">
          <span>Step <strong id="current-step-display" class="nums">1</strong> of 7</span>
        </div>

        <button type="button" class="btn btn-ink btn-sm" id="next-tool-btn">
          <span>Next tool</span>
        </button>
      </div>
    </div>

    <!-- Quiet editorial facts line folded below sheet (Replaces generic 3-card grid) -->
    <div class="research-facts-line muted" data-reveal>
      <div class="fact-item">
        <HardDrive size={14} stroke-width={1.75} class="fact-icon" />
        <span>Works offline and signed in</span>
      </div>
      <span class="fact-separator" aria-hidden="true">/</span>
      <div class="fact-item">
        <Cpu size={14} stroke-width={1.75} class="fact-icon" />
        <span>Claude can do it through the MCP</span>
      </div>
      <span class="fact-separator" aria-hidden="true">/</span>
      <div class="fact-item">
        <ShieldCheck size={14} stroke-width={1.75} class="fact-icon" />
        <span>Every card keeps its exact source</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";
  import { prefersReducedMotion } from "../../lib/reveal";

  const section = document.querySelector("#research");
  if (section) {
    const tabButtons = Array.from(section.querySelectorAll(".tab-btn")) as HTMLButtonElement[];
    const panels = Array.from(section.querySelectorAll(".tool-panel")) as HTMLElement[];
    const indicator = section.querySelector("#tab-indicator") as HTMLElement | null;
    const prevBtn = section.querySelector("#prev-tool-btn") as HTMLButtonElement | null;
    const nextBtn = section.querySelector("#next-tool-btn") as HTMLButtonElement | null;
    const stepDisplay = section.querySelector("#current-step-display") as HTMLElement | null;

    let currentIndex = 0;

    function updateIndicator(activeBtn: HTMLButtonElement) {
      if (!indicator) return;
      const btnRect = activeBtn.getBoundingClientRect();
      const parentRect = activeBtn.parentElement?.getBoundingClientRect();
      if (!parentRect) return;

      const left = btnRect.left - parentRect.left;
      const width = btnRect.width;

      indicator.style.left = `${left}px`;
      indicator.style.width = `${width}px`;
    }

    function switchTab(index: number) {
      if (index < 0 || index >= tabButtons.length) return;
      currentIndex = index;

      tabButtons.forEach((btn, idx) => {
        const isActive = idx === index;
        btn.classList.toggle("is-active", isActive);
        btn.setAttribute("aria-selected", String(isActive));
      });

      panels.forEach((panel, idx) => {
        const isActive = idx === index;
        if (isActive) {
          panel.style.display = "block";
          if (!prefersReducedMotion()) {
            animate(panel, { opacity: [0, 1], y: [8, 0] }, { duration: 0.22, ease: [0.16, 1, 0.3, 1] });
          }
        } else {
          panel.style.display = "none";
        }
      });

      const activeBtn = tabButtons[index];
      if (activeBtn) updateIndicator(activeBtn);

      // Update footer buttons (No arrows, simple sentence case labels)
      if (prevBtn) {
        prevBtn.disabled = index === 0;
      }
      if (nextBtn) {
        if (index === tabButtons.length - 1) {
          nextBtn.textContent = "Back to start";
        } else {
          nextBtn.textContent = "Next tool";
        }
      }

      if (stepDisplay) {
        stepDisplay.textContent = String(index + 1);
      }
    }

    tabButtons.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        switchTab(idx);
      });
    });

    prevBtn?.addEventListener("click", () => {
      if (currentIndex > 0) switchTab(currentIndex - 1);
    });

    nextBtn?.addEventListener("click", () => {
      if (currentIndex < tabButtons.length - 1) {
        switchTab(currentIndex + 1);
      } else {
        switchTab(0);
      }
    });

    // Initialize indicator position
    const initialBtn = tabButtons[0];
    if (initialBtn) {
      setTimeout(() => {
        updateIndicator(initialBtn);
      }, 50);
      window.addEventListener("resize", () => {
        const curBtn = tabButtons[currentIndex];
        if (curBtn) updateIndicator(curBtn);
      });
    }
  }
</script>

<style>
  .research-sheet {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  /* Tab Bar */
  .research-tabbar-wrap {
    background: var(--desk);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .research-tabbar-wrap::-webkit-scrollbar {
    display: none;
  }

  .research-tabbar {
    position: relative;
    display: flex;
    align-items: center;
    min-width: max-content;
    padding: 0 12px;
  }

  .tab-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 48px;
    padding: 0 14px;
    border: 0;
    background: transparent;
    color: var(--muted-foreground);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    transition: color 140ms var(--ease-out);
    white-space: nowrap;
  }

  .tab-btn:hover {
    color: var(--foreground);
  }

  .tab-btn.is-active {
    color: var(--foreground);
    font-weight: 600;
  }

  .tab-num {
    opacity: 0.6;
    font-size: 12px;
  }

  .tab-btn.is-active .tab-num {
    opacity: 1;
    color: var(--primary);
  }

  .tab-indicator {
    position: absolute;
    bottom: 0;
    left: 12px;
    width: 80px;
    height: 2px;
    background: var(--primary);
    border-radius: 999px;
    transition:
      left 220ms var(--ease-spring),
      width 220ms var(--ease-spring);
    pointer-events: none;
  }

  /* Content Area */
  .research-content-area {
    padding: 24px 28px;
    min-height: 420px;
    background: var(--background);
  }

  @media (max-width: 640px) {
    .research-content-area {
      padding: 16px;
    }
  }

  .tool-panel {
    display: flex;
    flex-direction: column;
  }

  /* Footer Stepper */
  .research-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    background: var(--desk);
    border-top: 1px solid var(--border);
  }

  .step-progress-counter {
    font-size: 12.5px;
  }

  /* Quiet Editorial Facts Line (No generic cards) */
  .research-facts-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 20px;
    margin-top: 24px;
    font-size: 13px;
    color: var(--muted-foreground);
  }

  .fact-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .fact-icon {
    color: var(--primary);
    opacity: 0.7;
  }

  .fact-separator {
    opacity: 0.3;
    font-family: var(--font-mono);
  }

  @media (max-width: 680px) {
    .research-facts-line {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      margin-top: 20px;
      padding-inline: 8px;
    }
    .fact-separator {
      display: none;
    }
  }
</style>
