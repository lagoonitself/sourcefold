---
/**
 * Organize section: "Organize".
 * Desktop-style sidebar tree (project switcher, groups inside groups, drag to reorder and nest),
 * group view with rows (sources, note row, image row), multi-select action bar, and toast.
 */
import SectionHeader from "../SectionHeader.astro";
import SourceTile from "../SourceTile.astro";
import {
  ChevronDown,
  ChevronRight,
  Folder,
  FolderOpen,
  Plus,
  Archive,
  Check,
  Copy,
  FolderInput,
  GripVertical,
  Ellipsis,
  Image as ImageIcon,
  StickyNote,
} from "@lucide/astro";
---

<section id="organize" class="section">
  <div class="container">
    <SectionHeader
      label="Organize"
      title="Groups inside groups,"
      marked="as deep as you like"
      lede="Projects (one per video or article you're working on), groups inside groups as deep as you like. Drag to reorder and nest, with notes and images right next to your sources."
    />

    <!-- Interactive Desktop App Frame -->
    <div class="sheet organize-frame" data-reveal>
      <!-- App Window Top Bar -->
      <div class="app-topbar">
        <div class="topbar-left">
          <!-- Window traffic dots -->
          <div class="window-controls" aria-hidden="true">
            <span class="control-dot close"></span>
            <span class="control-dot min"></span>
            <span class="control-dot max"></span>
          </div>

          <!-- Project switcher -->
          <div class="project-dropdown-wrap">
            <button
              type="button"
              id="project-switcher-btn"
              class="project-switcher-btn"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span class="project-name">Cars</span>
              <ChevronDown size={14} stroke-width={1.75} class="project-chevron" />
            </button>

            <!-- Project menu -->
            <div id="project-menu" class="card project-menu" style="display: none;">
              <div class="menu-header muted">Projects</div>
              <button type="button" class="menu-item is-active">
                <Check size={14} stroke-width={2} class="item-check" />
                <span>Cars</span>
              </button>
              <button type="button" class="menu-item">
                <span class="item-check-placeholder"></span>
                <span>Autonomous driving</span>
              </button>
              <button type="button" class="menu-item">
                <span class="item-check-placeholder"></span>
                <span>Solid-state batteries</span>
              </button>
              <div class="menu-divider"></div>
              <button type="button" id="archive-project-btn" class="menu-item menu-item-archive">
                <Archive size={14} stroke-width={1.75} class="muted" />
                <span>Archive project</span>
              </button>
            </div>
          </div>

          <!-- Breadcrumb -->
          <nav class="breadcrumb-trail" aria-label="Breadcrumb">
            <span class="muted">Cars</span>
            <span class="crumb-sep muted">/</span>
            <span id="breadcrumb-parent" class="muted">Engines</span>
            <span class="crumb-sep muted">/</span>
            <span id="breadcrumb-current" class="crumb-active">Turbocharging</span>
          </nav>
        </div>

        <div class="topbar-right">
          <span class="sync-status muted">
            <span class="sync-dot" aria-hidden="true"></span>
            <span>Synced</span>
          </span>
          <button type="button" class="btn btn-ink btn-sm" id="add-links-btn">
            <Plus size={14} stroke-width={2} />
            <span>Add links</span>
          </button>
        </div>
      </div>

      <!-- App Workspace Body -->
      <div class="app-body">
        <!-- Sidebar Tree -->
        <aside class="app-sidebar" aria-label="Project groups">
          <div class="sidebar-header">
            <span class="sidebar-title muted">Groups</span>
            <button
              type="button"
              class="btn-icon-subtle"
              id="new-group-btn"
              aria-label="New group"
              title="New group"
            >
              <Plus size={14} stroke-width={2} />
            </button>
          </div>

          <!-- Tree View -->
          <div class="sidebar-tree" role="tree" id="sidebar-tree">
            <!-- Group 1: Engines -->
            <div class="tree-branch" data-group-id="engines">
              <div
                class="tree-row"
                role="treeitem"
                aria-expanded="true"
                data-group="Engines"
                data-count="14"
                draggable="true"
              >
                <button
                  type="button"
                  class="chevron-toggle"
                  aria-label="Toggle Engines"
                >
                  <ChevronDown size={14} stroke-width={1.75} class="branch-chevron" />
                </button>
                <span class="group-folder-icon" aria-hidden="true">
                  <FolderOpen size={14} stroke-width={1.75} />
                </span>
                <span class="group-label">Engines</span>
                <span class="group-count nums muted">14</span>
              </div>

              <!-- Children of Engines -->
              <div class="tree-children">
                <!-- Child 1: Turbocharging (Active) -->
                <div class="tree-branch" data-group-id="turbocharging">
                  <div
                    class="tree-row is-open"
                    role="treeitem"
                    aria-expanded="true"
                    data-group="Turbocharging"
                    data-parent="Engines"
                    data-count="6"
                    draggable="true"
                  >
                    <button
                      type="button"
                      class="chevron-toggle"
                      aria-label="Toggle Turbocharging"
                    >
                      <ChevronDown size={14} stroke-width={1.75} class="branch-chevron" />
                    </button>
                    <span class="group-folder-icon" aria-hidden="true">
                      <FolderOpen size={14} stroke-width={1.75} />
                    </span>
                    <span class="group-label">
                      <span class="marker marker-pill">Turbocharging</span>
                    </span>
                    <span class="group-count nums muted">6</span>
                  </div>

                  <!-- Subgroups of Turbocharging -->
                  <div class="tree-children">
                    <div
                      class="tree-row"
                      role="treeitem"
                      data-group="Lag and boost"
                      data-parent="Turbocharging"
                      data-count="3"
                      draggable="true"
                    >
                      <span class="tree-indent" aria-hidden="true"></span>
                      <span class="group-folder-icon" aria-hidden="true">
                        <Folder size={14} stroke-width={1.75} />
                      </span>
                      <span class="group-label">Lag and boost</span>
                      <span class="group-count nums muted">3</span>
                    </div>

                    <div
                      class="tree-row"
                      role="treeitem"
                      data-group="Twin-scroll"
                      data-parent="Turbocharging"
                      data-count="3"
                      draggable="true"
                    >
                      <span class="tree-indent" aria-hidden="true"></span>
                      <span class="group-folder-icon" aria-hidden="true">
                        <Folder size={14} stroke-width={1.75} />
                      </span>
                      <span class="group-label">Twin-scroll</span>
                      <span class="group-count nums muted">3</span>
                    </div>
                  </div>
                </div>

                <!-- Child 2: Naturally aspirated -->
                <div
                  class="tree-row"
                  role="treeitem"
                  data-group="Naturally aspirated"
                  data-parent="Engines"
                  data-count="5"
                  draggable="true"
                >
                  <span class="tree-indent" aria-hidden="true"></span>
                  <span class="group-folder-icon" aria-hidden="true">
                    <Folder size={14} stroke-width={1.75} />
                  </span>
                  <span class="group-label">Naturally aspirated</span>
                  <span class="group-count nums muted">5</span>
                </div>

                <!-- Child 3: Rotary & Wankel -->
                <div
                  class="tree-row"
                  role="treeitem"
                  data-group="Rotary & Wankel"
                  data-parent="Engines"
                  data-count="3"
                  draggable="true"
                >
                  <span class="tree-indent" aria-hidden="true"></span>
                  <span class="group-folder-icon" aria-hidden="true">
                    <Folder size={14} stroke-width={1.75} />
                  </span>
                  <span class="group-label">Rotary & Wankel</span>
                  <span class="group-count nums muted">3</span>
                </div>
              </div>
            </div>

            <!-- Group 2: Aerodynamics -->
            <div class="tree-branch is-collapsed" data-group-id="aero">
              <div
                class="tree-row"
                role="treeitem"
                aria-expanded="false"
                data-group="Aerodynamics"
                data-count="8"
                draggable="true"
              >
                <button
                  type="button"
                  class="chevron-toggle"
                  aria-label="Toggle Aerodynamics"
                >
                  <ChevronRight size={14} stroke-width={1.75} class="branch-chevron" />
                </button>
                <span class="group-folder-icon" aria-hidden="true">
                  <Folder size={14} stroke-width={1.75} />
                </span>
                <span class="group-label">Aerodynamics</span>
                <span class="group-count nums muted">8</span>
              </div>
              <div class="tree-children" style="display: none;">
                <div
                  class="tree-row"
                  role="treeitem"
                  data-group="Ground effect"
                  data-parent="Aerodynamics"
                  data-count="4"
                  draggable="true"
                >
                  <span class="tree-indent" aria-hidden="true"></span>
                  <span class="group-folder-icon" aria-hidden="true">
                    <Folder size={14} stroke-width={1.75} />
                  </span>
                  <span class="group-label">Ground effect</span>
                  <span class="group-count nums muted">4</span>
                </div>
                <div
                  class="tree-row"
                  role="treeitem"
                  data-group="Active wings"
                  data-parent="Aerodynamics"
                  data-count="4"
                  draggable="true"
                >
                  <span class="tree-indent" aria-hidden="true"></span>
                  <span class="group-folder-icon" aria-hidden="true">
                    <Folder size={14} stroke-width={1.75} />
                  </span>
                  <span class="group-label">Active wings</span>
                  <span class="group-count nums muted">4</span>
                </div>
              </div>
            </div>

            <!-- Group 3: Chassis & suspension -->
            <div class="tree-branch is-collapsed" data-group-id="chassis">
              <div
                class="tree-row"
                role="treeitem"
                aria-expanded="false"
                data-group="Chassis & suspension"
                data-count="6"
                draggable="true"
              >
                <button
                  type="button"
                  class="chevron-toggle"
                  aria-label="Toggle Chassis"
                >
                  <ChevronRight size={14} stroke-width={1.75} class="branch-chevron" />
                </button>
                <span class="group-folder-icon" aria-hidden="true">
                  <Folder size={14} stroke-width={1.75} />
                </span>
                <span class="group-label">Chassis & suspension</span>
                <span class="group-count nums muted">6</span>
              </div>
            </div>
          </div>
        </aside>

        <!-- Main Group View -->
        <main class="app-main-content">
          <!-- Group View Header -->
          <div class="group-view-header">
            <div class="header-titles">
              <h3 class="group-title serif">
                <span id="group-name-heading" class="marker marker-sweep is-in">
                  Turbocharging
                </span>
              </h3>
              <p class="group-meta muted" id="group-meta-text">
                2 subgroups, 6 sources (14 highlights)
              </p>
            </div>

            <div class="group-actions">
              <button type="button" class="btn btn-outline btn-sm" id="btn-new-subgroup">
                <span>New subgroup</span>
              </button>
              <button type="button" class="btn btn-outline btn-sm" id="btn-add-image">
                <ImageIcon size={14} stroke-width={1.75} />
                <span>Add image</span>
              </button>
              <button type="button" class="btn btn-outline btn-sm" id="btn-new-note">
                <StickyNote size={14} stroke-width={1.75} />
                <span>New note</span>
              </button>
            </div>
          </div>

          <!-- Multi-select Action Bar (Floating when items selected) -->
          <div id="selection-action-bar" class="selection-action-bar card" style="display: none;">
            <div class="selection-count">
              <span id="selected-items-count" class="nums">0</span> selected
            </div>
            <div class="selection-buttons">
              <button type="button" class="btn btn-outline btn-sm" id="batch-move-btn">
                <FolderInput size={14} stroke-width={1.75} />
                <span>Move</span>
              </button>
              <button type="button" class="btn btn-ink btn-sm" id="batch-copy-links-btn">
                <Copy size={14} stroke-width={1.75} />
                <span>Copy links</span>
              </button>
              <button
                type="button"
                class="btn btn-ghost btn-sm"
                id="batch-deselect-btn"
                aria-label="Clear selection"
              >
                <span>Deselect</span>
              </button>
            </div>
          </div>

          <!-- Draggable Rows List -->
          <div class="group-rows-list" id="group-rows-list" role="list">
            <!-- Row 1: YouTube -->
            <div
              class="item-row"
              role="listitem"
              data-id="row-yt"
              data-url="youtube.com/watch?v=Q3pWg1Zt9ac"
            >
              <div class="row-drag-handle" title="Drag to reorder" aria-hidden="true">
                <GripVertical size={14} stroke-width={1.75} />
              </div>
              <label class="row-checkbox-wrap">
                <input type="checkbox" class="row-checkbox sr-only" />
                <span class="checkbox-visual" aria-hidden="true">
                  <Check size={11} stroke-width={2.5} class="check-icon" />
                </span>
                <span class="sr-only">Select How turbo lag actually works</span>
              </label>
              <SourceTile kind="youtube" size={30} />
              <div class="row-text">
                <span class="row-title serif">How turbo lag actually works</span>
                <span class="row-subtext muted">Engineering Explained / YouTube (12:04)</span>
              </div>
              <div class="row-type-badge muted">YouTube</div>
              <div class="row-date muted nums">Oct 17</div>
              <button
                type="button"
                class="btn-icon-subtle row-more-btn"
                aria-label="Row actions"
              >
                <Ellipsis size={15} stroke-width={1.75} />
              </button>
            </div>

            <!-- Row 2: Grokipedia -->
            <div
              class="item-row"
              role="listitem"
              data-id="row-grok"
              data-url="grokipedia.com/page/Turbocharger"
            >
              <div class="row-drag-handle" title="Drag to reorder" aria-hidden="true">
                <GripVertical size={14} stroke-width={1.75} />
              </div>
              <label class="row-checkbox-wrap">
                <input type="checkbox" class="row-checkbox sr-only" />
                <span class="checkbox-visual" aria-hidden="true">
                  <Check size={11} stroke-width={2.5} class="check-icon" />
                </span>
                <span class="sr-only">Select Turbocharger</span>
              </label>
              <SourceTile kind="grokipedia" size={30} />
              <div class="row-text">
                <span class="row-title serif">Turbocharger</span>
                <span class="row-subtext muted">Grokipedia / 8 footnotes / Complete article</span>
              </div>
              <div class="row-type-badge muted">Grokipedia</div>
              <div class="row-date muted nums">Oct 16</div>
              <button
                type="button"
                class="btn-icon-subtle row-more-btn"
                aria-label="Row actions"
              >
                <Ellipsis size={15} stroke-width={1.75} />
              </button>
            </div>

            <!-- Row 3: Substack -->
            <div
              class="item-row"
              role="listitem"
              data-id="row-sub"
              data-url="enginebay.substack.com/p/the-last-rotary"
            >
              <div class="row-drag-handle" title="Drag to reorder" aria-hidden="true">
                <GripVertical size={14} stroke-width={1.75} />
              </div>
              <label class="row-checkbox-wrap">
                <input type="checkbox" class="row-checkbox sr-only" />
                <span class="checkbox-visual" aria-hidden="true">
                  <Check size={11} stroke-width={2.5} class="check-icon" />
                </span>
                <span class="sr-only">Select The last rotary</span>
              </label>
              <SourceTile kind="substack" size={30} />
              <div class="row-text">
                <span class="row-title serif">The last rotary</span>
                <span class="row-subtext muted">Engine Bay / Substack (3 images)</span>
              </div>
              <div class="row-type-badge muted">Substack</div>
              <div class="row-date muted nums">Oct 14</div>
              <button
                type="button"
                class="btn-icon-subtle row-more-btn"
                aria-label="Row actions"
              >
                <Ellipsis size={15} stroke-width={1.75} />
              </button>
            </div>

            <!-- Row 4: Note (EXTRA_KINDS) -->
            <div class="item-row" role="listitem" data-id="row-note" data-url="">
              <div class="row-drag-handle" title="Drag to reorder" aria-hidden="true">
                <GripVertical size={14} stroke-width={1.75} />
              </div>
              <label class="row-checkbox-wrap">
                <input type="checkbox" class="row-checkbox sr-only" />
                <span class="checkbox-visual" aria-hidden="true">
                  <Check size={11} stroke-width={2.5} class="check-icon" />
                </span>
                <span class="sr-only">Select Script ideas for the intro</span>
              </label>
              <SourceTile kind="note" size={30} />
              <div class="row-text">
                <span class="row-title serif">Script ideas for the intro</span>
                <span class="row-subtext muted">Markdown note / "Hook: 930 turbo lag vs EV instant torque"</span>
              </div>
              <div class="row-type-badge muted">Note</div>
              <div class="row-date muted nums">Oct 17</div>
              <button
                type="button"
                class="btn-icon-subtle row-more-btn"
                aria-label="Row actions"
              >
                <Ellipsis size={15} stroke-width={1.75} />
              </button>
            </div>

            <!-- Row 5: Image (EXTRA_KINDS) -->
            <div class="item-row" role="listitem" data-id="row-img" data-url="">
              <div class="row-drag-handle" title="Drag to reorder" aria-hidden="true">
                <GripVertical size={14} stroke-width={1.75} />
              </div>
              <label class="row-checkbox-wrap">
                <input type="checkbox" class="row-checkbox sr-only" />
                <span class="checkbox-visual" aria-hidden="true">
                  <Check size={11} stroke-width={2.5} class="check-icon" />
                </span>
                <span class="sr-only">Select Dyno chart, 2JZ stock vs single turbo</span>
              </label>
              <SourceTile kind="image" size={30} />
              <div class="row-text">
                <span class="row-title serif">Dyno chart, 2JZ stock vs single turbo</span>
                <span class="row-subtext muted">Image / PNG (1.4 MB) / Kept in Drive</span>
              </div>
              <div class="row-type-badge muted">Image</div>
              <div class="row-date muted nums">Oct 16</div>
              <button
                type="button"
                class="btn-icon-subtle row-more-btn"
                aria-label="Row actions"
              >
                <Ellipsis size={15} stroke-width={1.75} />
              </button>
            </div>

            <!-- Row 6: Reddit -->
            <div
              class="item-row"
              role="listitem"
              data-id="row-reddit"
              data-url="reddit.com/r/cars/comments/1g7"
            >
              <div class="row-drag-handle" title="Drag to reorder" aria-hidden="true">
                <GripVertical size={14} stroke-width={1.75} />
              </div>
              <label class="row-checkbox-wrap">
                <input type="checkbox" class="row-checkbox sr-only" />
                <span class="checkbox-visual" aria-hidden="true">
                  <Check size={11} stroke-width={2.5} class="check-icon" />
                </span>
                <span class="sr-only">Select Is the 2JZ overrated</span>
              </label>
              <SourceTile kind="reddit" size={30} />
              <div class="row-text">
                <span class="row-title serif">Is the 2JZ overrated?</span>
                <span class="row-subtext muted">r/cars / Reddit (342 comments)</span>
              </div>
              <div class="row-type-badge muted">Reddit</div>
              <div class="row-date muted nums">Oct 15</div>
              <button
                type="button"
                class="btn-icon-subtle row-more-btn"
                aria-label="Row actions"
              >
                <Ellipsis size={15} stroke-width={1.75} />
              </button>
            </div>
          </div>
        </main>
      </div>

      <!-- Toast Notification -->
      <div id="organize-toast" class="organize-toast card" style="display: none;" role="status">
        <Check size={16} stroke-width={2} class="toast-check" />
        <span id="toast-text">Copied 3 links</span>
      </div>
    </div>

    <!-- Feature Pillars under the desktop mock -->
    <div class="organize-grid" data-reveal="stagger">
      <div class="feature-point card">
        <h3 class="point-title serif">Projects</h3>
        <p class="muted">
          One project per video, article, or thesis. Everything inside stays organized, isolated,
          and ready for AI prompting.
        </p>
      </div>

      <div class="feature-point card">
        <h3 class="point-title serif">Groups as deep as you like</h3>
        <p class="muted">
          Nest sub-topics, chapters, and tangents naturally. No arbitrary folder depth limits or
          rigid taxonomy schemes.
        </p>
      </div>

      <div class="feature-point card">
        <h3 class="point-title serif">Drag to reorder and nest</h3>
        <p class="muted">
          Reorder items to build your narrative flow, or drop a group onto another to nest it. Real
          spring physics with instant feedback.
        </p>
      </div>

      <div class="feature-point card">
        <h3 class="point-title serif">Notes and images next to sources</h3>
        <p class="muted">
          Keep your thoughts, scratchpads, screenshots, and dyno charts right alongside the articles
          and videos that inspired them.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";
  import { prefersReducedMotion } from "../../lib/reveal";

  const section = document.querySelector("#organize");
  if (section) {
    const projectBtn = section.querySelector("#project-switcher-btn") as HTMLButtonElement | null;
    const projectMenu = section.querySelector("#project-menu") as HTMLElement | null;
    const archiveBtn = section.querySelector("#archive-project-btn") as HTMLButtonElement | null;
    const toast = section.querySelector("#organize-toast") as HTMLElement | null;
    const toastText = section.querySelector("#toast-text") as HTMLElement | null;

    const groupHeading = section.querySelector("#group-name-heading") as HTMLElement | null;
    const groupMeta = section.querySelector("#group-meta-text") as HTMLElement | null;
    const breadcrumbParent = section.querySelector("#breadcrumb-parent") as HTMLElement | null;
    const breadcrumbCurrent = section.querySelector("#breadcrumb-current") as HTMLElement | null;

    const selectionBar = section.querySelector("#selection-action-bar") as HTMLElement | null;
    const selectionCount = section.querySelector("#selected-items-count") as HTMLElement | null;
    const copyLinksBtn = section.querySelector("#batch-copy-links-btn") as HTMLButtonElement | null;
    const deselectBtn = section.querySelector("#batch-deselect-btn") as HTMLButtonElement | null;
    const batchMoveBtn = section.querySelector("#batch-move-btn") as HTMLButtonElement | null;

    const newSubgroupBtn = section.querySelector("#btn-new-subgroup") as HTMLButtonElement | null;
    const addImgBtn = section.querySelector("#btn-add-image") as HTMLButtonElement | null;
    const newNoteBtn = section.querySelector("#btn-new-note") as HTMLButtonElement | null;

    const rowsList = section.querySelector("#group-rows-list") as HTMLElement | null;
    const itemRows = Array.from(section.querySelectorAll(".item-row")) as HTMLElement[];
    const treeRows = Array.from(section.querySelectorAll(".tree-row")) as HTMLElement[];
    const chevrons = Array.from(section.querySelectorAll(".chevron-toggle")) as HTMLButtonElement[];

    let toastTimer: number | null = null;

    function showToast(message: string) {
      if (!toast || !toastText) return;
      toastText.textContent = message;
      toast.style.display = "inline-flex";

      if (!prefersReducedMotion()) {
        animate(toast, { opacity: [0, 1], y: [16, 0] }, { duration: 0.24, ease: [0.32, 0.72, 0, 1] });
      }

      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        if (!prefersReducedMotion()) {
          animate(toast, { opacity: [1, 0], y: [0, 8] }, { duration: 0.2, ease: [0.16, 1, 0.3, 1] }).then(
            () => {
              toast.style.display = "none";
            }
          );
        } else {
          toast.style.display = "none";
        }
      }, 2400);
    }

    // Project Switcher Dropdown & Selection
    projectBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (!projectMenu) return;
      const isOpen = projectMenu.style.display === "block";
      projectMenu.style.display = isOpen ? "none" : "block";
      projectBtn.setAttribute("aria-expanded", String(!isOpen));
    });

    document.addEventListener("click", (e) => {
      if (projectMenu && !projectMenu.contains(e.target as Node) && e.target !== projectBtn) {
        projectMenu.style.display = "none";
        projectBtn?.setAttribute("aria-expanded", "false");
      }
    });

    const projectItems = Array.from(
      projectMenu?.querySelectorAll(".menu-item:not(.menu-item-archive)") || []
    ) as HTMLButtonElement[];

    projectItems.forEach((item) => {
      item.addEventListener("click", () => {
        projectItems.forEach((pi) => {
          pi.classList.remove("is-active");
          const chk = pi.querySelector(".item-check");
          if (chk) chk.remove();
          if (!pi.querySelector(".item-check-placeholder")) {
            const span = document.createElement("span");
            span.className = "item-check-placeholder";
            pi.prepend(span);
          }
        });
        item.classList.add("is-active");
        item.querySelector(".item-check-placeholder")?.remove();
        const checkIcon = document.createElement("span");
        checkIcon.className = "item-check";
        checkIcon.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
        item.prepend(checkIcon);

        const newName = item.querySelector("span:last-child")?.textContent || "Cars";
        const nameSpan = projectBtn?.querySelector(".project-name");
        if (nameSpan) nameSpan.textContent = newName;
        const trailSpan = section.querySelector(".breadcrumb-trail > span:first-child");
        if (trailSpan) trailSpan.textContent = newName;

        if (projectMenu) projectMenu.style.display = "none";
        projectBtn?.setAttribute("aria-expanded", "false");
        showToast(`Switched project to '${newName}'`);
      });
    });

    // Archive project action
    archiveBtn?.addEventListener("click", () => {
      const curName = projectBtn?.querySelector(".project-name")?.textContent || "Cars";
      if (projectMenu) projectMenu.style.display = "none";
      projectBtn?.setAttribute("aria-expanded", "false");
      showToast(`Archived project '${curName}'`);

      // Switch to next active project
      const nextProj = projectItems.find((pi) => !pi.classList.contains("is-active"));
      if (nextProj) nextProj.click();
    });

    // Header buttons (New subgroup, Add image, New note)
    newSubgroupBtn?.addEventListener("click", () => {
      showToast("Created subgroup in Turbocharging");
    });

    addImgBtn?.addEventListener("click", () => {
      showToast("Added image dyno-comparison.png to Turbocharging");
    });

    newNoteBtn?.addEventListener("click", () => {
      showToast("Created note in Turbocharging");
    });

    batchMoveBtn?.addEventListener("click", () => {
      showToast("Moved selected items to Lag and boost");
    });

    // Expand / Collapse Chevron Toggles
    chevrons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const branch = btn.closest(".tree-branch") as HTMLElement | null;
        if (!branch) return;
        const children = branch.querySelector(".tree-children") as HTMLElement | null;
        const chevronIcon = btn.querySelector(".branch-chevron") as HTMLElement | null;

        const isCurrentlyCollapsed = branch.classList.contains("is-collapsed");

        if (isCurrentlyCollapsed) {
          branch.classList.remove("is-collapsed");
          if (children) children.style.display = "block";
          if (chevronIcon) chevronIcon.style.transform = "rotate(0deg)";
        } else {
          branch.classList.add("is-collapsed");
          if (children) children.style.display = "none";
          if (chevronIcon) chevronIcon.style.transform = "rotate(-90deg)";
        }
      });
    });

    // Sidebar group selection & heading marker sweep
    treeRows.forEach((row) => {
      row.addEventListener("click", () => {
        const groupName = row.dataset.group;
        if (!groupName) return;

        // Update active class in sidebar
        treeRows.forEach((r) => {
          r.classList.remove("is-open");
          const pill = r.querySelector(".marker-pill");
          if (pill) {
            pill.classList.remove("marker", "marker-pill");
          }
        });

        row.classList.add("is-open");
        const labelEl = row.querySelector(".group-label");
        if (labelEl && !labelEl.querySelector(".marker")) {
          labelEl.innerHTML = `<span class="marker marker-pill">${groupName}</span>`;
        }

        // Update breadcrumb
        const parentName = row.dataset.parent || "Cars";
        if (breadcrumbParent) breadcrumbParent.textContent = parentName;
        if (breadcrumbCurrent) breadcrumbCurrent.textContent = groupName;

        // Update group header with re-sweeping marker
        if (groupHeading) {
          groupHeading.innerHTML = `<span class="marker marker-sweep">${groupName}</span>`;
          void groupHeading.offsetWidth;
          groupHeading.classList.add("is-in");
        }

        if (groupMeta) {
          const count = row.dataset.count || "6";
          groupMeta.textContent = `${count} sources in this group`;
        }

        // Stagger rows entrance (20ms stagger)
        if (!prefersReducedMotion() && rowsList) {
          const currentRows = Array.from(rowsList.querySelectorAll(".item-row")) as HTMLElement[];
          animate(
            currentRows,
            { opacity: [0, 1], y: [12, 0] },
            { duration: 0.35, delay: (i) => i * 0.02, ease: [0.16, 1, 0.3, 1] }
          );
        }
      });
    });

    // Multi-select checkboxes
    function updateSelectionState() {
      const selected = itemRows.filter((r) => {
        const cb = r.querySelector(".row-checkbox") as HTMLInputElement | null;
        return cb?.checked ?? false;
      });

      itemRows.forEach((r) => {
        const cb = r.querySelector(".row-checkbox") as HTMLInputElement | null;
        if (cb?.checked) {
          r.classList.add("is-selected");
        } else {
          r.classList.remove("is-selected");
        }
      });

      if (!selectionBar || !selectionCount) return;

      if (selected.length > 0) {
        selectionCount.textContent = String(selected.length);
        selectionBar.style.display = "flex";
      } else {
        selectionBar.style.display = "none";
      }
    }

    itemRows.forEach((row) => {
      const cb = row.querySelector(".row-checkbox") as HTMLInputElement | null;
      cb?.addEventListener("change", () => {
        updateSelectionState();
      });

      // Clicking row toggles selection if clicking outside buttons/drag-handle
      row.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (
          target.tagName === "BUTTON" ||
          target.closest("button") ||
          target.tagName === "INPUT" ||
          target.closest(".row-drag-handle")
        ) {
          return;
        }
        if (cb) {
          cb.checked = !cb.checked;
          updateSelectionState();
        }
      });
    });

    deselectBtn?.addEventListener("click", () => {
      itemRows.forEach((r) => {
        const cb = r.querySelector(".row-checkbox") as HTMLInputElement | null;
        if (cb) cb.checked = false;
      });
      updateSelectionState();
    });

    copyLinksBtn?.addEventListener("click", () => {
      const selected = itemRows.filter((r) => {
        const cb = r.querySelector(".row-checkbox") as HTMLInputElement | null;
        return cb?.checked ?? false;
      });
      const count = selected.length || 3;
      showToast(`Copied ${count} links`);
    });

    // Reorder Rows via Pointer Events (Touch & Mouse with Pointer Capture on handle only)
    // touch-action: none is on .row-drag-handle, allowing normal page scrolling elsewhere
    let draggedRow: HTMLElement | null = null;
    let placeholder: HTMLElement | null = null;
    let startY = 0;

    itemRows.forEach((row) => {
      const handle = row.querySelector(".row-drag-handle") as HTMLElement | null;
      if (!handle) return;

      handle.addEventListener("pointerdown", (e) => {
        e.preventDefault();
        draggedRow = row;
        startY = e.clientY;

        handle.setPointerCapture(e.pointerId);
        row.classList.add("is-dragging");

        // Insert placeholder
        placeholder = document.createElement("div");
        placeholder.className = "row-drop-placeholder";
        placeholder.style.height = `${row.offsetHeight}px`;
        row.parentNode?.insertBefore(placeholder, row.nextSibling);

        const onPointerMove = (ev: PointerEvent) => {
          if (!draggedRow || !rowsList) return;
          const deltaY = ev.clientY - startY;
          draggedRow.style.transform = `translateY(${deltaY}px)`;

          // Check hit position against sibling rows
          const siblings = Array.from(rowsList.querySelectorAll(".item-row:not(.is-dragging)")) as HTMLElement[];
          for (const sib of siblings) {
            const rect = sib.getBoundingClientRect();
            if (ev.clientY > rect.top && ev.clientY < rect.bottom) {
              const mid = rect.top + rect.height / 2;
              if (ev.clientY < mid) {
                rowsList.insertBefore(placeholder!, sib);
              } else {
                rowsList.insertBefore(placeholder!, sib.nextSibling);
              }
              break;
            }
          }
        };

        const onPointerUp = (ev: PointerEvent) => {
          handle.releasePointerCapture(ev.pointerId);
          window.removeEventListener("pointermove", onPointerMove);
          window.removeEventListener("pointerup", onPointerUp);
          window.removeEventListener("pointercancel", onPointerUp);

          if (!draggedRow || !placeholder) return;

          // Settle into placeholder
          placeholder.parentNode?.insertBefore(draggedRow, placeholder);
          placeholder.remove();
          placeholder = null;

          draggedRow.classList.remove("is-dragging");
          draggedRow.style.transform = "";
          draggedRow = null;
        };

        window.addEventListener("pointermove", onPointerMove);
        window.addEventListener("pointerup", onPointerUp);
        window.addEventListener("pointercancel", onPointerUp);
      });
    });

    // Group Nesting Drag and Drop in Sidebar Tree (HTML5 & Pointer support)
    let draggedGroup: HTMLElement | null = null;
    treeRows.forEach((row) => {
      row.addEventListener("dragstart", (e) => {
        draggedGroup = row;
        row.classList.add("is-group-dragging");
        if (e.dataTransfer) {
          e.dataTransfer.setData("text/plain", row.dataset.group || "");
          e.dataTransfer.effectAllowed = "move";
        }
      });

      row.addEventListener("dragend", () => {
        row.classList.remove("is-group-dragging");
        treeRows.forEach((r) => r.classList.remove("is-drop-target"));
        draggedGroup = null;
      });

      row.addEventListener("dragover", (e) => {
        if (!draggedGroup || draggedGroup === row) return;
        e.preventDefault();
        row.classList.add("is-drop-target");
      });

      row.addEventListener("dragleave", () => {
        row.classList.remove("is-drop-target");
      });

      row.addEventListener("drop", (e) => {
        e.preventDefault();
        row.classList.remove("is-drop-target");
        if (!draggedGroup || draggedGroup === row) return;

        const sourceName = draggedGroup.dataset.group;
        const targetName = row.dataset.group;

        // Move the branch physically in DOM
        const draggedBranch = draggedGroup.closest(".tree-branch") || draggedGroup;
        const targetBranch = row.closest(".tree-branch") || row;

        if (
          draggedBranch &&
          targetBranch &&
          draggedBranch !== targetBranch &&
          !draggedBranch.contains(targetBranch)
        ) {
          let childrenContainer = targetBranch.querySelector(":scope > .tree-children") as HTMLElement | null;
          if (!childrenContainer) {
            childrenContainer = document.createElement("div");
            childrenContainer.className = "tree-children";
            targetBranch.appendChild(childrenContainer);
          }
          childrenContainer.appendChild(draggedBranch);
          childrenContainer.style.display = "block";
          targetBranch.classList.remove("is-collapsed");
        }

        showToast(`Nested '${sourceName}' inside '${targetName}'`);
      });
    });
  }
</script>

