---
/**
 * Hero section (section id "top").
 * Contract: docs/dev/handoff-landing.md
 *
 * Requirements:
 * - Headline reads in five seconds and fits 1440x900 viewport with demo visible above fold
 * - Strict 2-line headline at 1440px, 768px, and 390px
 * - Lede: crisp, punchy, ~25 words
 * - Two CTAs: Primary "Download for Windows/Mac" (or anchor #download), Secondary "Read the doc" (#sources)
 * - Interactive AddLinksDemo desktop mock
 * - Floating/ticker SourceMarquee beneath
 */
import { Download as DownloadIcon, FileText } from "@lucide/astro";
import AddLinksDemo from "../hero/AddLinksDemo.astro";
import SourceMarquee from "../hero/SourceMarquee.astro";
---

<section id="top" class="hero-section" data-hero-section>
  <div class="container hero-container">
    <div class="hero-grid">
      <!-- Left Column: Copy, CTAs, Trust proof -->
      <div class="hero-copy-column">
        <h1 class="hero-headline">
          Everything you read for a project, <span class="marker marker-sweep">in one folder</span>
        </h1>

        <p class="hero-lede">
          Paste 30–40 links from YouTube, Wikipedia, Substack, Reddit or arXiv.
          Sourcefold turns every page into a clean Markdown file in your Google Drive.
        </p>

        <div class="hero-actions">
          <a href="#download" class="btn btn-ink hero-cta-primary" data-os-cta>
            <DownloadIcon size={16} stroke-width={2} />
            <span data-cta-label>Download for Windows</span>
          </a>

          <a href="#sources" class="btn btn-ghost hero-cta-secondary">
            <FileText size={16} stroke-width={1.8} />
            <span>Supported sources</span>
          </a>
        </div>

        <div class="hero-trust">
          <span class="trust-item">Local Markdown</span>
          <span class="trust-sep">·</span>
          <span class="trust-item">Google Drive sync</span>
          <span class="trust-sep">·</span>
          <span class="trust-item">MIT licensed</span>
        </div>
      </div>

      <!-- Right Column: Interactive Desktop App Mock -->
      <div class="hero-demo-column">
        <AddLinksDemo />
      </div>
    </div>

    <!-- Supported sources strip underneath hero grid -->
    <SourceMarquee />
  </div>
</section>

<script>
  // Detect OS for hero CTA button
  const ctaBtn = document.querySelector<HTMLAnchorElement>("[data-os-cta]");
  const ctaLabel = document.querySelector<HTMLElement>("[data-cta-label]");

  if (ctaBtn && ctaLabel) {
    const ua = navigator.userAgent.toLowerCase();
    const isMac = /macintosh|mac os x/.test(ua);
    const isWin = /windows|win32|win64/.test(ua);

    if (isMac) {
      ctaLabel.textContent = "Download for Mac";
    } else if (isWin) {
      ctaLabel.textContent = "Download for Windows";
    } else {
      ctaLabel.textContent = "Download Sourcefold";
    }
  }
</script>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(16px, 2.5vh, 32px);
    padding-bottom: clamp(16px, 2.5vh, 28px);
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3.5vw, 40px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 36px;
    }
  }

  @media (min-width: 1200px) {
    .hero-grid {
      grid-template-columns: 1.08fr 1fr;
      gap: 44px;
    }
  }

  /* Left copy column */
  .hero-copy-column {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vh, 20px);
    max-width: 580px;
  }

  /*
   * Strict 2-line headline calibration:
   * clamp(30px, 3.2vw, 46px) keeps line 1 under 35ch measure,
   * guaranteeing exactly two lines at 1440px, 768px, and 390px.
   */
  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(30px, 3.2vw, 46px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--foreground);
    text-wrap: balance;
    max-width: 22ch;
    margin: 0;
  }

  .hero-lede {
    font-size: clamp(14.5px, 1.15vw, 16.5px);
    line-height: 1.48;
    color: var(--muted-foreground);
    max-width: 48ch;
    text-wrap: pretty;
    margin: 0;
  }

  /* CTA cluster */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 4px;
  }

  .hero-cta-primary {
    height: 42px;
    padding-inline: 18px;
    font-size: 14px;
    font-weight: 500;
    gap: 8px;
  }

  .hero-cta-secondary {
    height: 42px;
    padding-inline: 14px;
    font-size: 14px;
    gap: 7px;
  }

  /* Trust metadata strip */
  .hero-trust {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--muted-foreground);
    padding-top: 2px;
  }

  .trust-sep {
    color: var(--border-strong);
  }

  .hero-demo-column {
    min-width: 0;
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-cta-primary,
    .hero-cta-secondary {
      justify-content: center;
      width: 100%;
    }
    .hero-trust {
      justify-content: center;
    }
  }
</style>
