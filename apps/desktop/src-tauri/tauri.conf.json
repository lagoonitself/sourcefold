{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sourcefold",
  "version": "0.6.0",
  "identifier": "com.sourcefold.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sourcefold",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNzcwODc2ODg3OTU5N0IKUldSN1dYbUlkZ2gzMnhnSzFuaHdHZnR0Z1d3WHFjSko4WW1DOGVFZGhCcjA5UUZUOW5TRlRucTMK",
      "endpoints": [
        "https://github.com/lagoonitself/sourcefold/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
