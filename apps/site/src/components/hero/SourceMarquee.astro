---
/**
 * A quiet strip of source tiles + names (all of SOURCES) drifting slowly as a marquee.
 * Pauses on hover/focus, quad-duplicated track for a mathematically seamless infinite loop
 * across all screen sizes (including 1440px, 1920px and ultra-wide), mask fades on edges,
 * stops and wraps under reduced motion, linking to #sources.
 */
import SourceTile from "../SourceTile.astro";
import { SOURCES } from "../../lib/sources";
---

<div class="marquee-wrapper" aria-label="Supported source types strip">
  <div class="marquee-track">
    <div class="marquee-group">
      {
        SOURCES.map((source) => (
          <a href="#sources" class="marquee-pill" title={`Learn about saving from ${source.name}`}>
            <SourceTile kind={source.kind} size={24} />
            <span class="source-name">{source.name}</span>
          </a>
        ))
      }
    </div>
    <div class="marquee-group" aria-hidden="true">
      {
        SOURCES.map((source) => (
          <a href="#sources" class="marquee-pill" tabindex="-1">
            <SourceTile kind={source.kind} size={24} />
            <span class="source-name">{source.name}</span>
          </a>
        ))
      }
    </div>
    <div class="marquee-group" aria-hidden="true">
      {
        SOURCES.map((source) => (
          <a href="#sources" class="marquee-pill" tabindex="-1">
            <SourceTile kind={source.kind} size={24} />
            <span class="source-name">{source.name}</span>
          </a>
        ))
      }
    </div>
    <div class="marquee-group" aria-hidden="true">
      {
        SOURCES.map((source) => (
          <a href="#sources" class="marquee-pill" tabindex="-1">
            <SourceTile kind={source.kind} size={24} />
            <span class="source-name">{source.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-block: 10px;
    margin-top: clamp(20px, 2.8vh, 36px);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .marquee-track {
    display: flex;
    width: max-content;
    gap: 12px;
    animation: marquee-drift 38s linear infinite;
    will-change: transform;
  }

  .marquee-wrapper:hover .marquee-track,
  .marquee-wrapper:focus-within .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .marquee-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding-inline: 10px 14px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-raised);
    color: var(--foreground);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    transition:
      background-color 140ms var(--ease-out),
      border-color 140ms var(--ease-out),
      transform 140ms var(--ease-out),
      box-shadow 140ms var(--ease-out);
    white-space: nowrap;
  }

  .marquee-pill:hover {
    background: var(--accent);
    border-color: var(--border-strong);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sheet);
  }

  .source-name {
    color: var(--foreground);
  }

  /* 4 groups with 12px track gap: exactly 1 group shift is calc(-25% - 3px) */
  @keyframes marquee-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-25% - 3px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none !important;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }
    .marquee-group[aria-hidden="true"] {
      display: none;
    }
  }
</style>
