---
/** The Sourcefold mark: an ink tile with the folded S, its middle fold run over with the highlighter. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
const S_FOLD =
  "M 292 268 H 732 A 32 32 0 0 1 764 300 V 340 A 32 32 0 0 1 732 372 H 380 A 16 16 0 0 0 364 388 V 444 A 16 16 0 0 0 380 460 H 732 A 32 32 0 0 1 764 492 V 724 A 32 32 0 0 1 732 756 H 292 A 32 32 0 0 1 260 724 V 684 A 32 32 0 0 1 292 652 H 644 A 16 16 0 0 0 660 636 V 580 A 16 16 0 0 0 644 564 H 292 A 32 32 0 0 1 260 532 V 300 A 32 32 0 0 1 292 268 Z";
const clipId = `sf-fold-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="100 100 824 824"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
>
  <defs>
    <clipPath id={clipId}><path d={S_FOLD}></path></clipPath>
  </defs>
  <rect x="100" y="100" width="824" height="824" rx="200" fill="#15181E"></rect>
  <rect
    x="100"
    y="100"
    width="824"
    height="824"
    rx="200"
    fill="none"
    stroke="#FFFFFF"
    stroke-opacity="0.12"
    stroke-width="16"></rect>
  <path d={S_FOLD} fill="#FCFCFB"></path>
  <rect
    class="logo-fold"
    x="240"
    y="452"
    width="544"
    height="120"
    fill="#F5DC3C"
    clip-path={`url(#${clipId})`}></rect>
</svg>
