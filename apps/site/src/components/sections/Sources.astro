---

<section id="sources" class="section sources-section">
  <div class="container">
    <SectionHeader
      label="Supported sources"
      title="Save from the ten places research "
      marked="comes from"
      lede="Every source becomes a clean Markdown file. Paste 30–40 links of any mix."
    />

    <!-- Interactive Picker -->
    <div class="sources-interactive" data-sources-picker>
      <!-- Left: Sources tablist -->
      <div class="sources-list-column">
        <div
          class="sources-list"
          role="tablist"
          aria-label="Supported source types"
          data-sources-tablist
        >
          {
            SOURCES.map((source, index) => {
              const isFirst = index === 0;
              return (
                <button
                  type="button"
                  role="tab"
                  id={`source-tab-${source.kind}`}
                  aria-selected={isFirst ? "true" : "false"}
                  aria-controls={`source-panel-${source.kind}`}
                  tabindex={isFirst ? 0 : -1}
                  class={`source-tab ${isFirst ? "is-selected is-cycling" : ""}`}
                  data-source-kind={source.kind}
                  data-tab-index={index}
                >
                  <span class="tab-accent-bar" aria-hidden="true" style={`--source-brand: var(--source-${source.kind})`} />
                  <SourceTile kind={source.kind} size={28} />
                  <span class="source-tab-name">{source.name}</span>
                  <span class="tab-progress-line" aria-hidden="true" style={`--source-brand: var(--source-${source.kind})`} />
                </button>
              );
            })
          }
        </div>
      </div>

      <!-- Right: Preview Sheet -->
      <div class="preview-column">
        <div class="sheet preview-sheet" data-ui="markdown-preview">
          {
            SOURCES.map((source, index) => {
              const isFirst = index === 0;
              const detail = SOURCE_DETAILS[source.kind];
              return (
                <div
                  id={`source-panel-${source.kind}`}
                  role="tabpanel"
                  aria-labelledby={`source-tab-${source.kind}`}
                  class={`preview-panel ${isFirst ? "is-active" : ""}`}
                  hidden={!isFirst}
                  data-panel-kind={source.kind}
                >
                  <!-- Header: Save it with & What you get -->
                  <div class="preview-meta-header">
                    <div class="meta-row">
                      <span class="meta-label">Save it with</span>
                      <span class="meta-value">{source.savedWith}</span>
                    </div>
                    <div class="meta-row">
                      <span class="meta-label">What you get</span>
                      <span class="meta-value">{source.youGet}</span>
                    </div>
                  </div>

                  <!-- Markdown Preview inside sheet -->
                  <div class="markdown-preview">
                    <div class="markdown-file-tab">
                      <span class="file-name">{source.exampleUrl.split("/").pop() || source.kind}.md</span>
                      <span class="file-kind-badge" style={`color: var(--source-${source.kind})`}>
                        {source.name}
                      </span>
                    </div>

                    <div class="markdown-content">
                      <!-- Realistic Front matter syntax tinting -->
                      <div class="md-frontmatter">
                        <span class="md-fence">---</span>
                        <div class="md-line">
                          <span class="md-key">title:</span>
                          <span class="md-val">"{source.exampleTitle}"</span>
                        </div>
                        <div class="md-line">
                          <span class="md-key">source:</span>
                          <span class="md-val md-kind" style={`color: var(--source-${source.kind})`}>
                            {source.kind}
                          </span>
                        </div>
                        <div class="md-line">
                          <span class="md-key">url:</span>
                          <span class="md-val">"https://{source.exampleUrl}"</span>
                        </div>
                        <div class="md-line">
                          <span class="md-key">{detail.authorLabel}:</span>
                          <span class="md-val">"{detail.authorValue}"</span>
                        </div>
                        <div class="md-line">
                          <span class="md-key">saved:</span>
                          <span class="md-val">{detail.savedDate}</span>
                        </div>
                        <span class="md-fence">---</span>
                      </div>

                      <!-- Realistic body lines -->
                      <div class="md-body">
                        {detail.bodyLines.map((line) => {
                          if (line.type === "heading" || line.type === "ref-header") {
                            return <div class="md-heading serif">{line.text}</div>;
                          }
                          if (line.type === "timestamp") {
                            return (
                              <div class="md-timestamp-line">
                                <span class="md-time-link">{line.text}</span>
                                <span class="md-time-text">{line.subtext}</span>
                              </div>
                            );
                          }
                          if (line.type === "quote") {
                            return <div class="md-quote">{line.text}</div>;
                          }
                          if (line.type === "subquote") {
                            return <div class="md-subquote">{line.text}</div>;
                          }
                          if (line.type === "image") {
                            return <div class="md-image-line">{line.text}</div>;
                          }
                          if (line.type === "math") {
                            return <div class="md-math-block">{line.text}</div>;
                          }
                          if (line.type === "ref-item") {
                            return <div class="md-ref-item">{line.text}</div>;
                          }
                          return <div class="md-p">{line.text}</div>;
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>

    <!-- Below: Honest note + mention of notes and images -->
    <div class="sources-footer" data-reveal>
      <div class="honest-note">
        <p class="muted">
          Some sites (Reddit, paywalled news) refuse pasted links. Save those with the extension
          while the page is open; it saves the page as you see it.
        </p>
      </div>

      <div class="extra-kinds-bar">
        <span class="extra-label muted">Also lives next to your sources:</span>
        <div class="extra-chips">
          {
            EXTRA_KINDS.map((extra) => (
              <span class="extra-chip" title={extra.youGet}>
                <SourceTile kind={extra.kind} size={22} />
                <span class="extra-name">{extra.name}</span>
                <span class="extra-desc muted">({extra.savedWith})</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { whileVisible } from "../../lib/reveal";

  const root = document.querySelector<HTMLElement>("[data-sources-picker]");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const tablist = root.querySelector<HTMLElement>('[data-sources-tablist]');

    let currentIndex = 0;
    let userInteracted = false;
    let isHovering = false;
    let autoCycleTimer: ReturnType<typeof setTimeout> | null = null;
    let isVisible = false;

    function selectTab(index: number, options: { focus?: boolean } = {}) {
      if (index < 0 || index >= tabs.length) return;
      currentIndex = index;

      tabs.forEach((tab, i) => {
        const isMatch = i === index;
        tab.classList.toggle("is-selected", isMatch);
        tab.setAttribute("aria-selected", isMatch ? "true" : "false");
        tab.tabIndex = isMatch ? 0 : -1;
        if (isMatch && options.focus) {
          tab.focus();
        }
      });

      panels.forEach((panel, i) => {
        const isMatch = i === index;
        panel.classList.toggle("is-active", isMatch);
        panel.hidden = !isMatch;
      });

      // Manage auto-cycle progress bar
      if (!userInteracted && !isHovering && isVisible) {
        restartCycleTimer();
      } else {
        clearCycleTimer();
      }
    }

    function clearCycleTimer() {
      if (autoCycleTimer) {
        clearTimeout(autoCycleTimer);
        autoCycleTimer = null;
      }
      tabs.forEach((t) => t.classList.remove("is-cycling"));
    }

    function restartCycleTimer() {
      clearCycleTimer();
      if (userInteracted || isHovering || !isVisible) return;

      const activeTab = tabs[currentIndex];
      if (activeTab) {
        activeTab.classList.remove("is-cycling");
        void activeTab.offsetWidth; // Reflow to restart animation cleanly
        activeTab.classList.add("is-cycling");
      }

      autoCycleTimer = setTimeout(() => {
        if (!userInteracted && !isHovering && isVisible) {
          const nextIndex = (currentIndex + 1) % tabs.length;
          selectTab(nextIndex);
        }
      }, 3500);
    }

    // Keyboard navigation (roving tabindex)
    root.addEventListener("keydown", (e) => {
      const activeEl = document.activeElement as HTMLElement | null;
      if (!activeEl || activeEl.getAttribute("role") !== "tab") return;

      let targetIndex = -1;
      if (e.key === "ArrowDown" || e.key === "ArrowRight") {
        e.preventDefault();
        userInteracted = true;
        clearCycleTimer();
        targetIndex = (currentIndex + 1) % tabs.length;
      } else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
        e.preventDefault();
        userInteracted = true;
        clearCycleTimer();
        targetIndex = (currentIndex - 1 + tabs.length) % tabs.length;
      } else if (e.key === "Home") {
        e.preventDefault();
        userInteracted = true;
        clearCycleTimer();
        targetIndex = 0;
      } else if (e.key === "End") {
        e.preventDefault();
        userInteracted = true;
        clearCycleTimer();
        targetIndex = tabs.length - 1;
      }

      if (targetIndex !== -1) {
        selectTab(targetIndex, { focus: true });
      }
    });

    // Tab click & hover events
    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => {
        userInteracted = true;
        clearCycleTimer();
        selectTab(idx);
      });

      tab.addEventListener("mouseenter", () => {
        if (!userInteracted) {
          isHovering = true;
          clearCycleTimer();
          selectTab(idx);
        }
      });

      tab.addEventListener("focus", () => {
        if (!userInteracted) {
          selectTab(idx);
        }
      });
    });

    // Resume auto-cycling when cursor leaves tablist if user has not explicitly clicked
    if (tablist) {
      tablist.addEventListener("mouseleave", () => {
        if (!userInteracted) {
          isHovering = false;
          if (isVisible) {
            restartCycleTimer();
          }
        }
      });
    }

    // Auto-cycle only while visible in viewport
    whileVisible(root, () => {
      isVisible = true;
      if (!userInteracted && !isHovering) {
        restartCycleTimer();
      }
      return () => {
        isVisible = false;
        clearCycleTimer();
      };
    });
  }
</script>

<style>
  .sources-section {
    padding-top: clamp(40px, 6vw, 80px);
  }

  .sources-interactive {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  @media (min-width: 960px) {
    .sources-interactive {
      grid-template-columns: 290px 1fr;
      gap: 32px;
    }
  }

  /* Sources Tablist */
  .sources-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--card);
    padding: 8px;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-raised);
  }

  @media (max-width: 959px) {
    .sources-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 6px;
    }
  }

  @media (max-width: 480px) {
    .sources-list {
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      padding: 6px;
    }
  }

  .source-tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 42px;
    padding-inline: 12px 14px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
    text-align: left;
    outline: none;
    overflow: hidden;
    transition:
      background-color 140ms var(--ease-out),
      color 140ms var(--ease-out);
  }

  .source-tab:hover {
    background: var(--muted);
  }

  .source-tab:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }

  /* 3.5px source color bar on left when selected */
  .tab-accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3.5px;
    background: var(--source-brand);
    opacity: 0;
    transition: opacity 140ms var(--ease-out);
  }

  .source-tab.is-selected {
    background: var(--accent);
    font-weight: 500;
  }

  .source-tab.is-selected .tab-accent-bar {
    opacity: 1;
  }

  .source-tab-name {
    font-size: 13.5px;
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 480px) {
    .source-tab {
      height: 40px;
      padding-inline: 8px 10px;
      gap: 8px;
    }
    .source-tab-name {
      font-size: 12.5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* Auto-cycle progress bar on active tab */
  .tab-progress-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--source-brand);
    opacity: 0;
    transform-origin: left;
    transform: scaleX(0);
  }

  .source-tab.is-cycling .tab-progress-line {
    opacity: 0.7;
    animation: sf-tab-progress 3.5s linear forwards;
  }

  @keyframes sf-tab-progress {
    from {
